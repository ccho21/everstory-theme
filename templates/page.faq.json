                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_LkG3D3": {
                      "type": "text",
                      "settings": {
                        "text": "<p>All four materials are laminated and waterproof. Hand wash recommended; not dishwasher-safe.</p>",
                        "width": "100%",
