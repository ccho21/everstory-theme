                  },
                  "blocks": {
                    "text_pjAwCm": {
                      "type": "text",
                      "settings": {
                        "text": "<p>1\" / 25mm is the most popular — planners, journals, bottles, phone cases. 1.25\"–1.5\" for tumblers and laptops. 2\" and 2.5\" are statement sizes. 0.75\" for collectors/calendars.</p>",
