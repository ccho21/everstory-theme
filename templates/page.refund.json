                  "settings": {
                    "heading": "Local pickup",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_gxeMxj": {
                      "type": "text",
                      "settings": {
                        "text": "<p>If you selected Local Pickup, we email you after production to arrange a pickup location and time. Pickup is held for 30 days from that email. Orders not picked up within 30 days are not refunded but can still be claimed.</p>",
                        "width": "100%",
                        "max_width": "none",
