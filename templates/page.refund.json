                },
                "accordion_row_EayjHr": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "lost in transit",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_gR7pzM": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Canada Post lettermail does not include tracking. If your sheet has not arrived 14 business days after shipping confirmation, email us. We will reprint and reship one replacement at no cost. Lost replacements are evaluated case by case.</p>",
                        "width": "100%",
                        "max_width": "none",
