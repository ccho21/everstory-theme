      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"es-pdp\" lang=\"en\">\n  <div class=\"es-page\">\n    <section class=\"es-section\" aria-label=\"Product introduction\">\n      <div class=\"es-section-shell\">\n        <div class=\"heading-block\">\n          <span class=\"es-eyebrow\">Face sticker</span>\n          <h2>Their face, kept.</h2>\n        </div>\n\n        <div class=\"photo-pair\">\n          <div class=\"photo-frame\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0833/4760/3712/files/phone_sample.heic?v=1779210270\" alt=\"Face sticker on a phone case\">\n          </div>\n          <div class=\"photo-frame\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0833/4760/3712/files/laptop_sample.heic?v=1779210253\" alt=\"Face sticker on a laptop\">\n          </div>\n        </div>\n\n        <p class=\"copy\">\n          Your photo, traced and cut by hand into a die-cut sticker of the face and shoulders.\n          A white edge sits clean on a planner, a phone case, a laptop.\n          Choose your size; we pack each sheet by hand.\n        </p>\n\n        <div class=\"single-photo\" style=\"margin-top: 56px;\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0833/4760/3712/files/a5_sheet_real.jpg?v=1779213575\" alt=\"Printed A5 sticker sheet\">\n        </div>\n      </div>\n    </section>\n  </div>\n</div>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
