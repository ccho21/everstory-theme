                        "custom_liquid": "{% if closest.product.metafields.custom.is_package.value %}<p>Package Mini is one A5 sheet (148 &#215; 210 mm). Package Full is two. There is no size to choose \u2014 you upload candidates by print tier (Big, Medium, Small) and Studio lays out the final sheet.</p>{% else %}<p>Every order is one A5 sheet (148 &#215; 210 mm) in the size you choose, sized by the longest edge. <a href=\"#es-sizes\">See every size on the sheet, with sticker counts</a></p>{% endif %}"
