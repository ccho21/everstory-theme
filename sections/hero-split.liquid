{% liquid
  assign split = section.settings.split_ratio | default: '45-55'
%}

<div class="hero-split hero-split--{{ split }}">
  <div class="hero-split__inner">
    <div class="hero-split__content">
      {% content_for 'blocks' %}
    </div>

    <div class="hero-split__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'hero-split__image',
            loading: 'eager',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-split__image' }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-split {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding-block-start: 3vw;
    padding-block-end: clamp(32px, 6vw, 64px);
  }

  .hero-split__inner {
    max-width: var(--page-width, 1280px);
    margin-inline: auto;
    padding-inline: 24px;
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .hero-split__inner {
      gap: 48px;
      padding-inline: 48px;
    }
    .hero-split--45-55 .hero-split__inner { grid-template-columns: 45fr 55fr; }
    .hero-split--50-50 .hero-split__inner { grid-template-columns: 1fr 1fr; }
    .hero-split--55-45 .hero-split__inner { grid-template-columns: 55fr 45fr; }
  }

  .hero-split__media {
    order: -1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .hero-split__media {
      order: 0;
    }
  }

  .hero-split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-split__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Split",
  "blocks": [
    { "type": "@theme" },
    { "type": "text" },
    { "type": "button" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "jumbo-text" }
  ],
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "Split ratio",
      "options": [
        { "value": "45-55", "label": "45 / 55 (image-leaning)" },
        { "value": "50-50", "label": "50 / 50" },
        { "value": "55-45", "label": "55 / 45 (text-leaning)" }
      ],
      "default": "45-55"
    }
  ],
  "presets": [
    {
      "name": "Hero Split",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>Made in Toronto</p>",
            "type_preset": "h6"
          }
        },
        "headline": {
          "type": "text",
          "settings": {
            "text": "<h1>Photographs, kept by hand.</h1>",
            "type_preset": "h1",
            "max_width": "narrow"
          }
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "<p>A5 die-cut sticker sheets, traced and finished by hand on Korean premium substrates. Made to order, shipped in 2–5 business days.</p>",
            "max_width": "narrow"
          }
        },
        "cta_group": {
          "type": "group",
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 12,
            "width": "fit",
            "height": "fit"
          },
          "blocks": {
            "cta_primary": {
              "type": "button",
              "settings": {
                "label": "Shop the lookbook",
                "link": "shopify://collections/all"
              }
            },
            "cta_secondary": {
              "type": "button",
              "settings": {
                "label": "How it works",
                "style_class": "link"
              }
            }
          },
          "block_order": ["cta_primary", "cta_secondary"]
        }
      },
      "block_order": ["eyebrow", "headline", "body", "cta_group"]
    }
  ]
}
{% endschema %}
