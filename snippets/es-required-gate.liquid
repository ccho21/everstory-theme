{%- comment -%}
  EVERSTORY — gate the Add to cart button on Easify required options.

  Two jobs:

  1. UX layer — grey out Add to cart until every required Easify option is
     answered, instead of letting the shopper click and then get an error.
     Easify blocks the /cart/add call itself, so this only removes a dead click.

  2. Safety net — Easify renders the photo upload client-side. If its script
     never arrives (blocked, offline, JS error) the page still delivers a fully
     working Add to cart with NO upload attached, and a made-to-order sheet gets
     paid for with no photo. On a product that expects options, we wait
     PORTAL_TIMEOUT_MS for Easify and then block the button with a way out.

  Blocking is deliberately slow and narrow: it only engages after window load
  plus the timeout, and only where product.metafields.custom.no_photo_upload is
  not set. If Easify merely renames its classes the portal still exists, so the
  gate degrades to job 1 rather than blocking a sale.
{%- endcomment -%}

{%- comment -%}
  Every current product is built from a customer photograph. Set the
  custom.no_photo_upload boolean on any future product that ships without an
  upload (calligraphy, name tags, logo stickers) to opt it out of the safety net.
{%- endcomment -%}
{%- assign expect_options = true -%}
{%- if product.metafields.custom.no_photo_upload.value -%}
  {%- assign expect_options = false -%}
{%- endif -%}

<script>
(function () {
  if (window.__esRequiredGate) return;
  window.__esRequiredGate = true;

  var HINT_ID = 'es-required-hint';
  var PRIVACY_ID = 'es-photo-privacy-note';
  var EXPECT_OPTIONS = {{ expect_options | json }};
  /* Generous: Easify is third-party and slow mobile connections are normal.
     A false block costs a sale, so we would rather wait too long than too little. */
  var PORTAL_TIMEOUT_MS = 12000;
  var CONTACT_EMAIL = 'studio.everstory@gmail.com';

  var applying = false;
  var themeDisabled = null;
  var portalOverdue = false;
  var portalSeen = false;

  /* Labels of REQUIRED Easify options that are still empty.
     null = Easify has not rendered; apply() decides what that means. */
  function unmetLabels() {
    var portal = document.querySelector('.easify.portal');
    if (!portal) return null;
    portalSeen = true;

    var required = Array.prototype.slice
      .call(portal.querySelectorAll('.po-option-root'))
      .filter(function (o) { return o.querySelector('.po-label-required'); });
    if (!required.length) return [];

    return required.filter(function (o) {
      /* Easify writes every answered option into a hidden properties[...] input.
         This is the only signal that works for text, dropdown AND file upload —
         it clears input.files after uploading and stores the CDN url instead. */
      return !Array.prototype.slice
        .call(o.querySelectorAll('input[name^="properties"]'))
        .some(function (i) { return (i.value || '').trim() !== ''; });
    }).map(function (o) {
      var l = o.querySelector('.po-label-label');
      return l ? (l.textContent || '').trim() : '';
    }).filter(Boolean);
  }

  function notInQuickAdd(b) { return !b.closest('quick-add-dialog, .quick-add-modal'); }

  function mainButton() {
    return Array.prototype.slice
      .call(document.querySelectorAll('add-to-cart-component button[ref="addToCartButton"]'))
      .filter(notInQuickAdd)[0];
  }

  function allButtons() {
    return Array.prototype.slice.call(document.querySelectorAll(
      'add-to-cart-component button[ref="addToCartButton"],' +
      'sticky-add-to-cart button[ref="addToCartButton"],' +
      '.sticky-add-to-cart__button'
    )).filter(notInQuickAdd);
  }

  function setHint(text) {
    var host = document.querySelector(
      'product-form-component:not(.quick-add__product-form-component)'
    );
    if (!host) return;
    var el = document.getElementById(HINT_ID);
    if (text) {
      if (!el) {
        el = document.createElement('p');
        el.id = HINT_ID;
        el.setAttribute('aria-live', 'polite');
        el.style.cssText = 'margin:.5rem 0 0;font-size:max(.875rem, 13.5px);line-height:1.4;opacity:.7;';
        host.appendChild(el);
      }
      if (el.textContent !== text) el.textContent = text;
    } else if (el) {
      el.remove();
    }
  }

  function ensurePhotoPrivacy() {
    if (document.getElementById(PRIVACY_ID)) return;
    var portal = document.querySelector('.easify.portal');
    if (!portal) return;

    var optionRoots = Array.prototype.slice.call(portal.querySelectorAll('.po-option-root'));
    var uploadOption = optionRoots.find(function (option) {
      var label = option.querySelector('.po-label-label');
      return label && /upload your photo/i.test(label.textContent || '');
    });
    if (!uploadOption) {
      var fileOptions = optionRoots.filter(function (option) {
        return option.querySelector('input[type="file"]');
      });
      uploadOption = fileOptions[fileOptions.length - 1];
    }
    if (!uploadOption) return;

    var note = document.createElement('div');
    note.id = PRIVACY_ID;
    note.className = 'es-photo-privacy-note';
    note.innerHTML = '<strong>Your photos stay private.</strong> '
      + 'We use uploads only to create your order, delete the originals within 90 days of fulfillment, '
      + 'and never share or post them without your written consent. '
      + '<a href="/policies/privacy-policy">Photo Privacy Policy</a>'
      + '<span>Every upload is checked before production. If a photo cannot be used, we’ll email before printing.</span>';
    uploadOption.insertAdjacentElement('afterend', note);
  }

  var UPLOAD_KEY_HANDLER = function (e) {
    if (e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
    e.preventDefault();
    e.currentTarget.click();
  };

  /* Easify's upload trigger is a plain <div> and its real file input is
     visibility:hidden, so a keyboard can never reach the one option a photo
     product cannot be ordered without. Make the trigger a focusable button.
     Presentation only — the hidden properties[...] inputs that unmetLabels()
     reads stay untouched. */
  function enhanceUploadA11y() {
    var portal = document.querySelector('.easify.portal');
    if (!portal) return;
    Array.prototype.slice
      .call(portal.querySelectorAll('.po-fileUpload-content:not([data-es-a11y])'))
      .forEach(function (t) {
        t.setAttribute('data-es-a11y', '1');
        t.setAttribute('role', 'button');
        t.setAttribute('tabindex', '0');
        if (!t.getAttribute('aria-label')) {
          var root = t.closest('.po-option-root');
          var label = root && root.querySelector('.po-label-label');
          var text = label ? (label.textContent || '').trim() : '';
          t.setAttribute('aria-label', text || 'Upload photos');
        }
        t.addEventListener('keydown', UPLOAD_KEY_HANDLER);
      });
  }

  function apply() {
    ensurePhotoPrivacy();
    enhanceUploadA11y();
    var unmet = unmetLabels();

    var main = mainButton();
    if (!main) return;

    /* Track what the theme itself wants, so "sold out" still wins over us. */
    if (themeDisabled === null) themeDisabled = main.disabled;

    var blockedByUs, msg;

    if (unmet === null) {
      /* Easify has not rendered. Stay out of the way until it is clearly late —
         then block, because the alternative is a paid order with no photograph. */
      if (!(EXPECT_OPTIONS && portalOverdue)) return;
      blockedByUs = !themeDisabled;
      msg = blockedByUs
        ? 'The photo upload could not load, so this order cannot be started yet. '
          + 'Please refresh the page — or email ' + CONTACT_EMAIL
          + ' and we will take your photos by email.'
        : '';
    } else {
      blockedByUs = !themeDisabled && unmet.length > 0;
      msg = blockedByUs ? 'Please complete: ' + unmet.join(', ') : '';
    }

    var want = themeDisabled || blockedByUs;

    applying = true;
    allButtons().forEach(function (b) {
      var isSticky = !!b.closest('sticky-add-to-cart') || b.classList.contains('sticky-add-to-cart__button');
      if (isSticky && blockedByUs && !themeDisabled) {
        /* The sticky bar exists to bring a reader 10,000px down the story back
           to the form. Disabling it there is a dead end — keep it clickable and
           turn the click into "scroll to the unfinished options" instead.
           Easify still blocks /cart/add itself, so this cannot oversell. */
        if (b.disabled) b.disabled = false;
        b.setAttribute('data-es-goto-options', '1');
      } else {
        b.removeAttribute('data-es-goto-options');
        if (b.disabled !== want) b.disabled = want;
      }
      if (msg) b.setAttribute('title', msg);
      else b.removeAttribute('title');
    });
    /* Release on a macrotask: MutationObserver callbacks are microtasks and
       would otherwise see applying === false and mistake our write for the theme's. */
    setTimeout(function () { applying = false; }, 0);

    setHint(msg);
  }

  /* setTimeout, not requestAnimationFrame: rAF is throttled to zero in background
     tabs, which would latch the debounce flag and freeze the gate permanently. */
  var timer = null;
  function schedule() {
    if (timer) return;
    timer = setTimeout(function () {
      timer = null;
      try { apply(); } catch (e) { /* never break the page */ }
    }, 50);
  }

  var btnObserver = new MutationObserver(function (muts) {
    if (applying) { schedule(); return; }
    muts.forEach(function (m) {
      if (m.attributeName === 'disabled' && m.target === mainButton()) {
        themeDisabled = m.target.disabled;
      }
    });
    schedule();
  });

  function observeButtons() {
    var m = mainButton();
    if (m) btnObserver.observe(m, { attributes: true, attributeFilter: ['disabled'] });
  }

  new MutationObserver(schedule).observe(document.body, {
    childList: true, subtree: true, attributes: true, attributeFilter: ['value']
  });
  document.addEventListener('input', schedule, true);
  document.addEventListener('change', schedule, true);

  /* Sticky-bar click while options are unmet: go to the first unfinished
     option. Capture phase so the theme's own add-to-cart listener never runs. */
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest && e.target.closest('[data-es-goto-options="1"]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    var portal = document.querySelector('.easify.portal');
    var target = null;
    if (portal) {
      target = Array.prototype.slice
        .call(portal.querySelectorAll('.po-option-root'))
        .filter(function (o) { return o.querySelector('.po-label-required'); })
        .filter(function (o) {
          return !Array.prototype.slice
            .call(o.querySelectorAll('input[name^="properties"]'))
            .some(function (i) { return (i.value || '').trim() !== ''; });
        })[0] || null;
    }
    if (!target) {
      target = document.querySelector('product-form-component:not(.quick-add__product-form-component)');
    }
    if (!target) return;

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
    var focusable = target.querySelector('input:not([type=hidden]), textarea, select, [tabindex], [role="button"]');
    if (focusable && focusable.focus) {
      setTimeout(function () {
        try { focusable.focus({ preventScroll: true }); } catch (err) { focusable.focus(); }
      }, reduced ? 0 : 350);
    }
  }, true);

  /* Count from window load, not from parse: a slow page should not be mistaken
     for a missing app. If Easify turns up later the poll below clears the block
     on its own, so this can only ever delay a sale, never lose one. */
  function startWatchdog() {
    setTimeout(function () {
      if (portalSeen) return;
      portalOverdue = true;
      schedule();
    }, PORTAL_TIMEOUT_MS);
  }
  if (document.readyState === 'complete') startWatchdog();
  else window.addEventListener('load', startWatchdog);

  observeButtons();
  schedule();
  /* Safety net: Easify and the theme both re-render the nodes we depend on. */
  setInterval(function () { observeButtons(); schedule(); }, 1000);
})();
</script>

<div class="es-purchase-assurance" aria-label="Purchase assurances">
  <p>
    <strong>Made-right promise</strong>
    <span>Print or cut issue? Send a photo within 7 days and we’ll reprint at no cost. <a href="/pages/refund-policy">Details</a></span>
  </p>
  <p>
    <strong>Clear delivery timing</strong>
    <span>Ships in 2–5 business days. Free Standard Lettermail arrives in 4–10 business days after dispatch; optional tracked Canada Post shipping is available at checkout. <a href="/pages/shipping-pickup">Shipping details</a></span>
  </p>
</div>

<style>
  .es-photo-privacy-note {
    margin: 10px 0 14px;
    padding: 12px 14px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    background: #faf9f7;
    /* 13.5px floor: 0.8125rem landed at 12px on mobile, under comfortable
       reading size for decision-relevant text. Same floor as the gate hint. */
    font-size: max(0.875rem, 13.5px);
    line-height: 1.55;
  }

  /* Keyboard path to the upload trigger (role=button is added by the gate
     script). 44px matches the WCAG touch-target floor; the trigger measured
     73×30px on mobile. */
  .easify.portal .po-fileUpload-content {
    min-block-size: 44px;
    justify-content: center;
  }

  .easify.portal .po-fileUpload-content:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .es-photo-privacy-note span {
    display: block;
    margin-top: 4px;
    opacity: 0.72;
  }

  .es-photo-privacy-note a,
  .es-purchase-assurance a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .es-purchase-assurance {
    display: grid;
    margin-top: 14px;
    border-block: 1px solid rgba(0, 0, 0, 0.12);
  }

  .es-purchase-assurance p {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 12px 0;
    font-size: max(0.875rem, 13.5px);
    line-height: 1.5;
  }

  .es-purchase-assurance p + p {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .es-purchase-assurance span {
    opacity: 0.72;
  }

  .jdgm-preview-badge:has(.jdgm-prev-badge[data-number-of-reviews='0']),
  .jdgm-review-widget:has(.jdgm-rev-widg[data-number-of-reviews='0']) {
    display: none !important;
  }

  @media (max-width: 749px) {
    .easify.portal > div,
    .easify.portal .po-productPageOptions-root,
    .easify.portal .po-optionSet-root,
    .easify.portal .po-options-root,
    .es-photo-privacy-note {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
  }
</style>
