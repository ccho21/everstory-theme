{%- liquid
  assign linked_variant = product.selected_or_first_available_variant

  if product.selected_variant == blank
    if product.handle == 'face-sticker' or product.handle == 'full-body-sticker'
      for product_variant in product.variants
        if product_variant.available and product_variant.options contains '1" / 25mm'
          assign linked_variant = product_variant
          break
        endif
      endfor
    endif
  endif

  echo linked_variant.url
-%}
