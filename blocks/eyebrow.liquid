{% liquid
  assign text = block.settings.text
  assign alignment = block.settings.alignment | default: 'left'
%}

{%- if text != blank or request.design_mode -%}
  <p
    class="eyebrow eyebrow--{{ alignment }}{% if block.settings.tight %} eyebrow--tight{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{ text }}
  </p>
{%- endif -%}

{% stylesheet %}
  .eyebrow {
    margin: 0;
    /* Body face (Inter), not the OS system stack. The eyebrow sits directly
       above a heading, so a system-font swap here was visible on every
       platform: SF Pro on macOS, Segoe UI on Windows, Roboto on Android. */
    font-family: var(--font-body--family, Inter, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.75rem;
    /* 600 + 0.14em match .hero-scatter__eyebrow so both eyebrow
       implementations render as one treatment. */
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
    /* layout/theme.liquid #es-brand repaints this with --es-clay. This is the
       default for contexts that block never loads in: 4.74:1 on white, where
       the previous #777 measured 4.48:1 and failed WCAG AA. */
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
  }
  .eyebrow--center { text-align: center; }
  .eyebrow--right  { text-align: right; }
  .eyebrow--tight  { margin-bottom: -0.75em; }
{% endstylesheet %}

{% schema %}
{
  "name": "Eyebrow",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "HOW IT WORKS"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "tight",
      "label": "Tight to next block",
      "default": true,
      "info": "Pulls the next block closer underneath (uses negative margin)."
    }
  ],
  "presets": [
    { "name": "Eyebrow" }
  ]
}
{% endschema %}
